# Screamer API configuration (ASP.NET Core reads these environment variables;
# "__" separates configuration sections, e.g. CloudinarySettings__ApiKey -> CloudinarySettings:ApiKey).
# Copy to .env (or set them in your shell / hosting provider). Never commit real values.

ConnectionStrings__ScreamerDbConnection=Server=localhost\sqlexpress;Database=Screamer;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

JwtSettings__Key=change-me-to-a-long-random-secret-at-least-32-chars

CloudinarySettings__CloudName=your-cloud-name
CloudinarySettings__ApiKey=your-cloudinary-api-key
CloudinarySettings__ApiSecret=your-cloudinary-api-secret

EmailSettings__ApiKey=your-sendgrid-api-key
EmailSettings__FromAddress=your-verified-sender-address
EmailSettings__FromName=Screamer

Algolia__ApplicationId=your-algolia-app-id
Algolia__APIKey=your-algolia-admin-or-write-key

Google__ClientId=your-google-oauth-client-id
Google__ClientSecret=your-google-oauth-client-secret

Facebook__AppId=your-facebook-app-id
Facebook__AppSecret=your-facebook-app-secret

# Angular client (Screamer.AngularUI/src/environments/*.ts) cannot read env vars at runtime.
# Put your Algolia SEARCH-ONLY key in the environment files locally and do not commit it.
